{
  "name": "simon-twitch",
  "productName": "Simon Twitch",
  "version": "0.1.0",
  "description": "Multi-Stream Twitch Client: bis zu 4 Streams, Chat- und Browser-Fenster",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.simon.twitch",
    "productName": "Simon Twitch",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "maintainer": "lordsimon666 <lordsimon666@users.noreply.github.com>"
    },
    "artifactName": "Simon-Twitch-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Simon-Twitch-${version}-portable.${ext}"
    }
  },
  "author": {
    "name": "lordsimon666",
    "email": "lordsimon666@users.noreply.github.com"
  },
  "homepage": "https://github.com/lordsimon666/Simon-Twitch",
  "repository": {
    "type": "git",
    "url": "https://github.com/lordsimon666/Simon-Twitch.git"
  }
}
