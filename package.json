{
  "name": "simon-twitch",
  "productName": "Simon Twitch",
  "version": "0.4.0",
  "description": "Multi-Stream Twitch Client: bis zu 4 Streams, Chat- und Browser-Fenster",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux AppImage deb flatpak --publish never",
    "dist:rpm": "bash packaging/rpm/build-rpm.sh"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.simon.twitch",
    "productName": "Simon Twitch",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Simon-Twitch-Setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "lordsimon666 <lordsimon666@users.noreply.github.com>",
      "synopsis": "Bis zu 4 Twitch-Streams gleichzeitig"
    },
    "portable": {
      "artifactName": "Simon-Twitch-Portable.${ext}"
    },
    "appImage": {
      "artifactName": "Simon-Twitch.${ext}"
    },
    "deb": {
      "artifactName": "Simon-Twitch.${ext}"
    },
    "flatpak": {
      "artifactName": "Simon-Twitch.${ext}",
      "runtimeVersion": "24.08",
      "baseVersion": "24.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=dri",
        "--socket=pulseaudio",
        "--share=network",
        "--talk-name=org.freedesktop.Notifications"
      ]
    },
    "icon": "build/icon.png"
  },
  "author": {
    "name": "lordsimon666",
    "email": "lordsimon666@users.noreply.github.com"
  },
  "homepage": "https://github.com/lordsimon666/Simon-Twitch",
  "repository": {
    "type": "git",
    "url": "https://github.com/lordsimon666/Simon-Twitch.git"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
